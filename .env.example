# ============================
# Orchestrator  .env  template
# ============================
# 1) Copy this file to .env (same directory).
# 2) Fill in real values. .env is gitignored.

# ---- LLM (DashScope / OpenAI-compatible) ----
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_API_KEY=replace-me
LLM_MODEL_FAST=qwen-plus
LLM_MODEL_LONG=qwen-long

# LLM retry policy (G1). llm.chat retries on HTTP 429/5xx/408/425 and network
# errors with exponential backoff, honouring the server's Retry-After header
# when present.
#   - LLM_MAX_RETRIES    : total attempts per call (initial + retries). 3
#                          gives ~14s of extra latency in the worst case.
#   - LLM_BACKOFF_BASE   : base of the exponential backoff; delay = base**n.
#   - LLM_BACKOFF_CAP    : upper bound on per-sleep duration (seconds).
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=1.5
LLM_BACKOFF_CAP=10

# Global LLM concurrency gate. Applies to *every* llm.chat call site —
# structure detection, Excel filter, parent extraction, routing, batch
# children, arbitration, /extract, /doc-edit. Lower if you keep seeing 429
# storms despite the retry backoff; raise if DashScope quota is comfortable.
# ORCH_QUESTION_CONCURRENCY below only gates the MoDora /chat fan-out and is
# a *separate* knob.
ORCH_LLM_CONCURRENCY=6

# ---- Orchestrator server ----
ORCH_HOST=127.0.0.1
ORCH_PORT=8888
ORCH_LOG_LEVEL=INFO
# Max concurrent outstanding questions against backend channels. DashScope
# 429s aggressively above 4-6 on qwen-plus; the LLM-side retry from G1
# absorbs intermittent rate limits, but a lower value here still reduces the
# total amount of backoff churn per /process.
ORCH_QUESTION_CONCURRENCY=8

# ---- LLM routing (G2) ----
# Before /chat dispatch we ask the LLM to pick the top-k most likely-to-
# answer files from each channel. If a channel already has <= top_k ready
# files, routing is skipped. Fallback on any routing failure is "keep all
# files", so setting this lower never makes answers worse, only cheaper.
ORCH_ROUTE_TOP_K=3
# How many characters of each file's head we feed into the routing prompt
# for disambiguation when the filename alone is ambiguous.
ORCH_ROUTE_BRIEF_CHARS=400

# ---- Entity extraction (G6) ----
# Minimum number of parent rows Excel must supply before we skip the
# MoDora LLM entity extraction step (which costs 2 extra calls AND tends
# to hallucinate). Set to 1 (default) to skip whenever Excel has any data;
# set to a very large number (e.g. 10_000) to force the legacy always-run
# behaviour; set to 0 means "always skip regardless of excel rows" (risky,
# breaks md/word-primary templates like TC2 — not recommended).
ORCH_ENTITY_EXTRACT_EXCEL_MIN=1

# ---- Backend endpoints ----
# Excel channel is handled in-process (header-to-header match + LLM fallback)
# from B1 onwards. This URL is kept only for backward compatibility and is
# never dialled when B1 has landed.
BACKEND_EXCEL_URL=http://127.0.0.1:9001/api/solve

# MD / TXT channel → MoDora-A instance. The path must be /api/chat.
# If you run a single MoDora process for both textual channels, point both
# MD_TXT and WORD at the same URL.
BACKEND_MD_TXT_URL=http://127.0.0.1:8005/api/chat

# Word channel → MoDora-B instance (separate port when you run two MoDora
# processes; otherwise reuse the MoDora-A URL).
BACKEND_WORD_URL=http://127.0.0.1:8006/api/chat

# Per-channel HTTP timeout (seconds). Isolates slow / stuck peers.
BACKEND_TIMEOUT=25

# ---- /ingest persistence ----
# Directory where /ingest keeps reference originals + PDF conversions.
# Defaults to <tempdir>/modora_orch_ingest. Override if you want ingest state
# to survive reboots or live on a larger volume. The sqlite registry that
# backs ingest_registry lives under this directory by default
# (<dir>/registry.sqlite3) and is restored on startup, so an orchestrator
# restart does *not* require a fresh /ingest.
# ORCH_INGEST_DIR=C:\ProgramData\modora_orch_ingest
# Override the registry DB file path directly (absolute path).
# ORCH_REGISTRY_DB=C:\ProgramData\modora_orch_ingest\registry.sqlite3

# ---- LibreOffice (md/txt/docx -> PDF) ----
# Absolute path to the LibreOffice binary. Leave unset to auto-discover via
# PATH (looks for `soffice` / `soffice.exe`) and the default Windows install
# path (C:\Program Files\LibreOffice\program\soffice.exe).
# LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
# Conversion timeout per file (seconds). Increase for huge docx.
LIBREOFFICE_TIMEOUT=60

# ---- MoDora ingest client ----
# Upload step HTTP timeout (seconds).
MODORA_UPLOAD_TIMEOUT=90
# How long to wait for MoDora to finish OCR + CCTree building per file.
MODORA_READY_TIMEOUT=600
# How often to poll /task/status while waiting.
MODORA_POLL_INTERVAL=2
